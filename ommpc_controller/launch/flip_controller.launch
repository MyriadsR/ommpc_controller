<launch>
  <arg name="odometry_topic" default="/mavros/local_position/odom"/>
  <arg name="ref_filename" default="/traj/vertical_flip.traj"/>
  <node pkg="ommpc_controller" type="ommpc_controller_example_node" name="ommpc_controller" output="screen">
    <remap from="/mavros/local_position/odom" to="$(arg odometry_topic)"/>
    <rosparam command="load" file="$(find ommpc_controller)/config/params_flip.yaml"/>
    <param name="ref_txt/ref_filename" value="$(arg ref_filename)"/>
  </node>
</launch>
